---
import Base from '../layouts/Base.astro';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page not found | Tharani Muthukumar" description="This page doesn't exist. Head back to Tharani Muthukumar's portfolio." noindex>
  <main id="main" class="contact" style="min-height:100svh;display:grid;place-items:center">
    <div class="container">
      <p class="eyebrow" style="justify-content:center"><span class="eyebrow__num">404</span> Lost the plot</p>
      <h1 class="contact__title display">This page didn't <span class="grad-text">convert.</span></h1>
      <p class="lead contact__lead">The link may be old or mistyped. Let's get you back to the good part.</p>
      <div class="contact__actions">
        <a class="btn btn--primary btn--lg" href={base}><ArrowLeft /> Back to the portfolio</a>
      </div>
    </div>
  </main>
</Base>
