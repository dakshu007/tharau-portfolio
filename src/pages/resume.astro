---
// Printable one-page résumé. scripts/resume.mjs prints this to public/Tharani-Muthukumar-Resume.pdf.
import { site, experience, projects, highlights, skills, education, certifications, leadership } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Résumé | Tharani Muthukumar</title>
    <meta name="description" content="One-page résumé of Tharani Muthukumar, growth marketer for B2B SaaS." />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={site.url} />
    <style is:inline set:html={`
      @font-face{font-family:'Google Sans';font-weight:400 700;src:url(${base}fonts/google-sans.woff2) format('woff2')}
      @font-face{font-family:'Poppins';font-weight:600;src:url(${base}fonts/poppins-600.woff2) format('woff2')}
    `} />
    <style>
      @page { size: A4; margin: 0; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { background: #e9e6e1; }
      body { font-family: 'Google Sans', Arial, sans-serif; color: #1a1a1d; font-size: 9.6pt; line-height: 1.42; }
      .page { width: 210mm; min-height: 297mm; margin: 0 auto; background: #fff; padding: 14mm 15mm 12mm; }
      header { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding-bottom: 10px; border-bottom: 2px solid #1a1a1d; }
      h1 { font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 25pt; letter-spacing: -0.03em; line-height: 1; }
      .role { margin-top: 6px; font-size: 11pt; color: #d9541b; font-weight: 600; }
      .contact { text-align: right; font-size: 8.8pt; color: #44444a; line-height: 1.6; }
      .contact a { color: inherit; text-decoration: none; }
      .grid { display: grid; grid-template-columns: 1.55fr 1fr; gap: 20px; margin-top: 12px; }
      h2 { font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 9.4pt; letter-spacing: 0.14em; text-transform: uppercase; color: #d9541b; margin: 12px 0 6px; }
      h3 { font-size: 10.2pt; font-weight: 700; }
      .meta { color: #5c5c63; font-size: 8.8pt; }
      p.summary { margin-top: 10px; color: #2b2b30; }
      ul { padding-left: 13px; margin-top: 4px; }
      li { margin: 2px 0; }
      .item { margin-bottom: 8px; }
      .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
      .chips span { border: 1px solid #d9d6d0; border-radius: 99px; padding: 1px 7px; font-size: 8.4pt; }
      .label { font-weight: 700; font-size: 9pt; margin-top: 6px; }
      @media screen { .page { margin: 24px auto; box-shadow: 0 10px 40px rgba(0,0,0,.12); } }
    </style>
  </head>
  <body>
    <main class="page">
      <header>
        <div>
          <h1>{site.name}</h1>
          <p class="role">Growth Marketer · B2B SaaS</p>
        </div>
        <div class="contact">
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          {site.location}<br />
          <a href={site.url}>dakshu007.github.io/tharau-portfolio</a>
        </div>
      </header>
      <p class="summary">
        Computer Science Engineering student (Class of 2027) who found her way into growth marketing. Four months on Yuko
        Loyalty at Cartrabbit: customer research, product positioning, messaging experiments, retention work with D2C brands
        and sales demos. Comfortable with data and tools, from Power BI dashboards to n8n automation.
      </p>

      <div class="grid">
        <div>
          <h2>Experience</h2>
          {experience.map((e) => (
            <div class="item">
              <h3>{e.role} · {e.company}</h3>
              <p class="meta">{e.period} · {e.location}</p>
              <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          ))}

          <h2>Projects</h2>
          {projects.map((p) => (
            <div class="item">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <p class="meta">{p.deliverables.join(' · ')}</p>
            </div>
          ))}
        </div>

        <div>
          <h2>Skills</h2>
          {skills.map((s) => (
            <>
              <p class="label">{s.group}</p>
              <div class="chips">{s.items.map((i) => <span>{i}</span>)}</div>
            </>
          ))}

          <h2>Education</h2>
          {education.map((e) => (
            <div class="item"><h3>{e.title}</h3><p class="meta">{e.org} · {e.meta}</p></div>
          ))}

          <h2>Certification</h2>
          {certifications.map((c) => <div class="item"><h3>{c.title}</h3></div>)}

          <h2>Leadership</h2>
          {leadership.map((l) => (
            <div class="item"><h3>{l.title}</h3><p class="meta">{l.org} · {l.meta}</p></div>
          ))}

          <h2>Highlights</h2>
          <ul>{highlights.slice(0, 3).concat(highlights.slice(4)).map((h) => <li>{h.title}</li>)}</ul>
        </div>
      </div>
    </main>
  </body>
</html>
